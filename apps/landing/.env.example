# Copy this file to .env.local and adjust for your environment;
# .env.local is gitignored.

# Set to "true" locally to stop the Google Tag Manager container from
# loading at all (see index.html and zh-tw/index.html) — defaults to
# loading it, same as apps/console/.env.example.
# VITE_DISABLE_ANALYTICS=true

# The marketing-analysis demo widget's AgentBridge connection (see
# src/marketing-demo/widget.js). Leaving VITE_ANALYSIS_API_KEY unset shows
# the widget's "not wired up yet" state instead of connecting — the
# quick-test buttons still work fully offline against mock data either way.
# VITE_ANALYSIS_WS_URL defaults to wss://onagent.shuttle.tools/ws and
# VITE_ANALYSIS_APP_ID defaults to "analysis-app" when unset, so only the
# key needs setting to point at production; override the other two to
# point at a local backend instead (e.g. the docker-compose stack in
# tmp/docker-compose.yml).
# VITE_ANALYSIS_WS_URL=ws://localhost:8090/ws
# VITE_ANALYSIS_APP_ID=analysis-app
# VITE_ANALYSIS_API_KEY=
