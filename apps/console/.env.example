# Backend the console talks to (see src/api.ts). Copy this file to
# .env.local and adjust for your environment; .env.local is gitignored.
VITE_CONSOLE_API_URL=http://localhost:8080

# Set to "true" locally to stop registrations from firing the GA4/Ads
# conversion event (see src/analytics.ts) — defaults to sending.
# VITE_DISABLE_ANALYTICS=true
