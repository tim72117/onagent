# 複製這個檔案為 .env，並填入你自己的實際值。
# .env 本身已被 .gitignore 排除，不會進版控。
#
# 完整說明另見 `go run ./cmd/server -h`（這是唯一的權威來源，這份檔案只是
# 方便複製貼上的起點）。

# --- 基本設定 ------------------------------------------------------------

# 監聽位址，預設 ":8080"
ADDR=:8080

# Postgres DSN，預設 "postgres://platform:platform@localhost:5434/platform?sslmode=disable"
DATABASE_URL=

# 設為 "production" 時，會把「未設定 APP_ORIGINS/ALLOWED_ORIGIN」
# 「COOKIE_SECURE=false」這類不安全預設值，從警告升級成直接拒絕啟動。
# 本機開發不需要設定。
APP_ENV=

# --- CORS / Origin 白名單 --------------------------------------------------

# 允許開啟 /ws 的第三方開發者網站來源（逗號分隔）。
# APP_ENV=production 時必填；未設定時本機開發接受任何來源。
APP_ORIGINS=

# 這個專案自己前端（console/admin）的來源（逗號分隔）——console Playground
# WebSocket + CORS，以及 /console、/auth、/admin 的憑證式 CORS 都靠這個。
# APP_ENV=production 時必填；未設定時本機開發預設 "http://localhost:5173"。
ALLOWED_ORIGIN=

# "true" 讓 session cookie 帶 Secure 屬性（APP_ENV=production 時必填）。
# 預設 "false"（純 HTTP，僅限本機開發）。
COOKIE_SECURE=

# --- 營運後台（admin）--------------------------------------------------

# 開機時建立的第一個營運後台帳號 email/密碼，帳號不存在才會建立。
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- 配額 -----------------------------------------------------------------

# 設為 "false" 完全停用每月 prompt 配額——給自建部署（非 onagent 自己的 SaaS）
# 用的。預設 "true"。
QUOTA_ENABLED=

# --- LLM 推論供應商 ---------------------------------------------------------

# 未設定時使用 mock 推論，不需要任何 LLM 憑證即可跑起來。
AI_PROVIDER=
AI_MODEL=
VLLM_BASE_URL=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# AI_PROVIDER=mock 時的情境檔路徑，直接透傳給 want（want 自己的
# provider=mock，不是這個套件的 inference.MockService）。
AI_MOCK_SCENARIO=

# want registry 的 workspace 路徑，預設空字串。
WANT_WORKSPACE=

# --- Google 登入（Sign in with Google，選用）-------------------------------
#
# 未設定 GOOGLE_OAUTH_CLIENT_ID 時，整個「用 Google 登入」功能直接停用：
# /auth/google/start 回 404，console 的登入頁也不會顯示 Google 按鈕。
# 要啟用的話，去 Google Cloud Console > APIs & Services > Credentials
# 建立一組 OAuth 2.0 Client ID（Application type 選 Web application），
# Authorized redirect URIs 要精確填入下面 GOOGLE_OAUTH_REDIRECT_URL 的值。

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 這個後端自己的 callback 網址，要跟 OAuth Client 上登記的 Authorized
# redirect URI 完全一致（含 port、路徑）。本機開發預設
# "http://localhost:8080/auth/google/callback"；APP_ENV=production 時必填。
GOOGLE_OAUTH_REDIRECT_URL=
